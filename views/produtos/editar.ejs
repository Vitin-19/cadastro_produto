<h1>Editar produto</h1>

<form action="/produtos/<%= produto.id %>" method="POST">
    <label for="nome">Nome:</label>
    <input id="nome" type="text" name="nome" value="<%= produto.nome %>" required>
    <br>
    <label for="preco">Preço:</label>
    <input id="preco" type="number" name="preco" min="0" step="0.01" value="<%= produto.preco %>" required>
    <br>
    <label for="quantidade">Quantidade:</label>
    <input id="quantidade" type="number" name="quantidade" min="0" value="<%= produto.quantidade %>" required>
    <br>
    <label for="categoriaId">Categoria:</label>
    <select id="categoriaId" name="categoriaId">
        <% categorias.forEach(categoria => { %>
            <option value="<%= categoria.id %>" <%= String(produto.categoriaId || '') === String(categoria.id) ? 'selected' : '' %>><%= categoria.nome %></option>
        <% }) %>
    </select>
    <br>
    <button type="submit">Atualizar</button>
</form>
